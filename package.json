		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"svelte-i18n": "^4.0.1",
		"tailwindcss": "^4.3.2",
		"web-haptics": "^0.0.6"
	}
